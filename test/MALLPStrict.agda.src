module MALLPStrict where

open import Agda.Builtin.Nat using (Nat; _+_; _*_; _-_)

answerAdd : Nat
answerAdd = 7 + 13

answerMonus : Nat
answerMonus = 2 - 5

answerMultiply : Nat
answerMultiply = (2 + 3) * 4

answerLet : Nat
answerLet = let value = 7 + 13 in value * 2

answerLetShared : Nat
answerLetShared = let value = 10 + 3 in value * value

answerLetUnused : Nat
answerLetUnused = let ignored = 1000 * 1000 in 7

open import Agda.Builtin.Bool using (Bool; true; false)

answerTrue : Bool
answerTrue = true

answerFalse : Bool
answerFalse = false

open import Agda.Builtin.Unit using (⊤; tt)

answerUnit : ⊤
answerUnit = tt

-- Linear function cases: one live argument, consumed exactly once.
answerIdentity : Nat → Nat
answerIdentity value = value

answerAddFive : Nat → Nat
answerAddFive value = value + 5

answerMonusFive : Nat → Nat
answerMonusFive value = value - 5

answerFiveMonus : Nat → Nat
answerFiveMonus value = 5 - value

answerMultiplyFive : Nat → Nat
answerMultiplyFive value = value * 5

open import Agda.Builtin.Int using (Int; pos)

answerInt : Int
answerInt = pos 2

answerAddTwo : Nat → Nat → Nat
answerAddTwo x y = x + y

answerMonusTwo : Nat → Nat → Nat
answerMonusTwo x y = x - y

answerReverseMonusTwo : Nat → Nat → Nat
answerReverseMonusTwo x y = y - x

answerMultiplyTwo : Nat → Nat → Nat
answerMultiplyTwo x y = x * y

answerThree : Nat → Nat → Nat → Nat
answerThree x y z = (x + z) * y

answerThreeLet : Nat → Nat → Nat → Nat
answerThreeLet x y z =
  let partial = x + z in partial * y

answerFour : Nat → Nat → Nat → Nat → Nat
answerFour w x y z = (w + y) * (x + z)
