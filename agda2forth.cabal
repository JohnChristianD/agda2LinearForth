cabal-version:      2.4
name:               agda2forth
version:            0.1.0.0
synopsis:           Agda backend for GNU Gforth
description:        -

-- Package layout follows upstream jespercockx/agda2scheme; the Forth backend
-- and its ABI checker are target-specific additions.
author:             Louis Milliken
maintainer:         L.m.Milliken@student.tudelft.nl

data-files:
    FLib.fth
data-dir:   data

extra-source-files:
    README.md
    test/TriplesFO.agda
    test/UnsupportedLiteral.agda
    test/gforth/abi-smoke.fs
    formal/LinearModalABI.agda
    formal/LinearModalStackEffects.agda
    formal/LinearModalExamples.agda
    formal/LinearModalRuntimeRefinement.agda

executable agda2forth
    main-is:          Main.hs
    other-modules:    Agda.Compiler.ToForth
                      Agda.Compiler.Erase
                      Paths_agda2forth
    autogen-modules:  Paths_agda2forth
    build-depends:    base >=4.15.0.0
                      , Agda >= 2.8
                      , containers >= 0.5.7.1
                      , deepseq >= 1.4.5
                      , mtl >= 2.2.2
                      , pretty >= 1.1.3.3
                      , s-cargot >= 0.1.4
                      , text >= 1.2.3.1
    hs-source-dirs:   src
    default-language: Haskell2010

    default-extensions:  BlockArguments
                       , ConstraintKinds
                       , DefaultSignatures
                       , DeriveAnyClass
                       , DeriveFoldable
                       , DeriveFunctor
                       , DeriveGeneric
                       , DeriveTraversable
                       , ExistentialQuantification
                       , FlexibleContexts
                       , FlexibleInstances
                       , FunctionalDependencies
                       , GeneralizedNewtypeDeriving
                       , LambdaCase
                       , MultiParamTypeClasses
                       , MultiWayIf
                       , NamedFieldPuns
                       , OverloadedStrings
                       , PatternSynonyms
                       , RankNTypes
                       , RecordWildCards
                       , ScopedTypeVariables
                       , StandaloneDeriving
                       , TupleSections
                       , TypeSynonymInstances

